{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "docusaurus.config.ts",
    "sidebars.ts"
  ],
  "exclude": [
    "server",
    "node_modules",
    "build"
  ]
}
