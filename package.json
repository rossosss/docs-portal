{
  "name": "docs-portal",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:validate": "node scripts/validate-sources.mjs",
    "docs:collect": "node scripts/collect-docs.mjs",
    "docs:manifest": "node scripts/generate-build-manifest.mjs",
    "start": "docusaurus start --host 127.0.0.1",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs",
    "verify:site": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "overrides": {
    "webpackbar": "7.0.0",
    "serialize-javascript": "7.1.1",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
