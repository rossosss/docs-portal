# Copy to .env for local development. Paths are relative to docs-portal.
LOCAL_TERMINAL_PATH=../terminal-demo
LOCAL_GATEWAY_PATH=../gateway-demo
LOCAL_COMMON_PATH=.
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_TOKEN=
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCS_API_URL=http://127.0.0.1:4000
SITE_URL=
BASE_URL=/docs-portal/
# Optional read-only PAT for private source clones:
DOCS_READ_TOKEN=

